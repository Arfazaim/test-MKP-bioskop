          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Denah kursi berhasil diambil (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res && res.data && Array.isArray(res.data.seats)) {",
                  "    const avail = res.data.seats.find(function (s) { return s.status === 'AVAILABLE'; });",
                  "    if (avail) {",
                  "        pm.collectionVariables.set('seat_id', String(avail.id));",
                  "    }",
                  "}"
                ]
              }
            }
